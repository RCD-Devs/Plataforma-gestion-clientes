# Misma URL en ambas si no usas pooler.
# Con Neon/Supabase: DATABASE_URL = URI con pooler; DIRECT_URL = URI directa (puerto 5432).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Secreto para firmar la cookie de sesión (JWT). Genera uno con:
# openssl rand -base64 32
AUTH_SECRET=

# Supabase Storage (Rec. #37) — Project Settings → API en el dashboard.
# La service_role key es de máximo privilegio: server-only, nunca en el
# navegador. No confundir con la anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Correo transaccional (Rec. #41) — resend.com → API Keys.
# Sin esta variable, los correos solo quedan logueados en consola (mismo
# comportamiento que antes de este cambio) — no es obligatoria para correr
# la app en local.
RESEND_API_KEY=
# Remitente. Sin dominio propio verificado en Resend, usa el de pruebas
# (onboarding@resend.dev) — solo llega a la casilla dueña de la cuenta de
# Resend. Verificar un dominio propio es Rec. #43, aparte.
EMAIL_FROM="REVO <onboarding@resend.dev>"
# URL pública de la app, usada para armar los links de los correos
# (recuperar contraseña, etc.). En producción, la URL real del deploy.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Asistente IA (fusión Codia Task, fase A) — aistudio.google.com/apikey,
# tier gratuito de Google, no pide tarjeta. Sin esta variable, el
# asistente responde con un mensaje claro de "no configurado" en vez de
# fallar — no es obligatoria para correr la app en local.
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Integraciones ---
# NOTION_TOKEN=

# --- Producción (se completan más adelante) ---
# Google SSO — diferido (ver ADR-007). Cuando se sume, reutiliza el mismo
# AUTH_SECRET de arriba para firmar la sesión, no hay que renombrar nada.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ALLOWED_SSO_DOMAINS=

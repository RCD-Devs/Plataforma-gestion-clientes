// Plataforma de gestión de clientes — Grupo Revo / Rompecabeza
// PostgreSQL (Vercel / Neon / Supabase). Los estados y roles siguen en String.
// DATABASE_URL: pooler (app). DIRECT_URL: conexión directa (db push / migrate).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id           String  @id @default(cuid())
  name         String
  code         String?
  contactEmail String?
  // Horas que otorga cada ciclo de la bolsa (Rec. #36) — no es un total
  // fijo de por vida, se renueva solo cada cycleMonths meses.
  contractedHours Float     @default(0)
  cycleMonths     Int       @default(1)
  // Ancla del ciclo (cuándo partió el contrato). Null = usa createdAt
  // (cubre clientes ya sembrados antes de Rec. #36).
  cycleStartDate  DateTime?
  isActive        Boolean   @default(true)
  color           String?
  createdAt       DateTime  @default(now())

  accountManagerId String?
  accountManager   User?   @relation("clientAccountManager", fields: [accountManagerId], references: [id])

  requests          Request[]
  users             User[]            @relation("clientUsers")
  hoursAdjustments  HoursAdjustment[]
}

// Ajuste manual a la bolsa de horas de un cliente (Rec. #36) — a
// diferencia de los ciclos automáticos (derivados, no se guardan),
// esto es un dato real que alguien ingresó a mano y no vence.
model HoursAdjustment {
  id        String   @id @default(cuid())
  hours     Float
  note      String?
  actorId   String?
  actorName String?
  createdAt DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Team {
  id    String  @id @default(cuid())
  name  String
  color String?

  members  User[]
  requests Request[]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("COORDINADOR_CUENTA")
  color     String?
  createdAt DateTime @default(now())

  isActive              Boolean   @default(true)
  passwordHash          String?
  previousPasswordHash  String?
  mustChangePassword    Boolean   @default(true)
  passwordChangedAt     DateTime?

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  clientId String?
  client   Client? @relation("clientUsers", fields: [clientId], references: [id])

  assigned       Request[]            @relation("assignee")
  timeEntries    TimeEntry[]
  comments       Comment[]
  resetTokens    PasswordResetToken[]
  managedClients Client[]             @relation("clientAccountManager")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Request {
  id             String    @id @default(cuid())
  key            String    @unique
  title          String
  type           String    @default("Solicitud")
  description    String    @default("")
  status         String    @default("POR_HACER")
  priority       String    @default("MEDIA")
  clientPriority Int?
  dueDate        DateTime?
  requesterEmail String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  finalizedAt    DateTime?

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  assigneeId String?
  assignee   User?   @relation("assignee", fields: [assigneeId], references: [id])

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  attachments Attachment[]
  comments    Comment[]
  timeEntries TimeEntry[]
  activities  Activity[]

  @@index([clientId])
  @@index([assigneeId])
  @@index([status])
}

model Attachment {
  id        String   @id @default(cuid())
  kind      String   @default("url")
  name      String
  url       String
  createdAt DateTime @default(now())

  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Comment {
  id         String   @id @default(cuid())
  body       String
  isClient   Boolean  @default(false)
  authorName String?
  createdAt  DateTime @default(now())

  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])
}

model TimeEntry {
  id        String   @id @default(cuid())
  hours     Float
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([requestId])
  @@index([userId])
}

model Activity {
  id        String   @id @default(cuid())
  type      String
  message   String
  actorName String?
  createdAt DateTime @default(now())

  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Notification {
  id             String   @id @default(cuid())
  recipientEmail String
  requestId      String?
  title          String
  body           String
  channel        String   @default("inapp")
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([recipientEmail])
}

// Bitácora de seguridad — login, cambios de contraseña, etc. Separada de
// Activity (que es el feed de negocio visible a usuarios) porque tiene otro
// dueño (seguridad, no el cliente) y otro ciclo de vida.
model AuditLog {
  id         String   @id @default(cuid())
  type       String
  actorId    String?
  actorEmail String?
  ip         String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

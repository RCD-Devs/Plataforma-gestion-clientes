// Plataforma de gestión de clientes — Grupo Revo / Rompecabeza
// PostgreSQL (Vercel / Neon / Supabase). Los estados y roles siguen en String.
// DATABASE_URL: pooler (app). DIRECT_URL: conexión directa (db push / migrate).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id           String  @id @default(cuid())
  name         String
  code         String?
  contactEmail String?
  // Horas que otorga cada ciclo de la bolsa (Rec. #36) — no es un total
  // fijo de por vida, se renueva solo cada cycleMonths meses.
  contractedHours Float     @default(0)
  cycleMonths     Int       @default(1)
  // Ancla del ciclo (cuándo partió el contrato). Null = usa createdAt
  // (cubre clientes ya sembrados antes de Rec. #36).
  cycleStartDate  DateTime?
  isActive        Boolean   @default(true)
  color           String?
  createdAt       DateTime  @default(now())

  accountManagerId String?
  accountManager   User?   @relation("clientAccountManager", fields: [accountManagerId], references: [id])

  requests          Request[]
  users             User[]            @relation("clientUsers")
  hoursAdjustments  HoursAdjustment[]
  projects          Project[]
}

// Un cliente puede tener varios proyectos (fusión con Codia Task,
// 2026-09-01) — cada uno es su propio tablero filtrado. La mantención
// general (formulario público, portal) sigue sin proyecto asignado.
model Project {
  id         String    @id @default(cuid())
  name       String
  createdAt  DateTime  @default(now())
  archivedAt DateTime?

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  requests Request[]

  @@index([clientId])
}

// Ajuste manual a la bolsa de horas de un cliente (Rec. #36) — a
// diferencia de los ciclos automáticos (derivados, no se guardan),
// esto es un dato real que alguien ingresó a mano y no vence.
model HoursAdjustment {
  id        String   @id @default(cuid())
  hours     Float
  note      String?
  actorId   String?
  actorName String?
  createdAt DateTime @default(now())

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Team {
  id    String  @id @default(cuid())
  name  String
  color String?

  members  User[]
  requests Request[]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      String   @default("COORDINADOR_CUENTA")
  color     String?
  createdAt DateTime @default(now())

  isActive              Boolean   @default(true)
  passwordHash          String?
  previousPasswordHash  String?
  mustChangePassword    Boolean   @default(true)
  passwordChangedAt     DateTime?

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  clientId String?
  client   Client? @relation("clientUsers", fields: [clientId], references: [id])

  assigned        Request[]              @relation("assignee")
  timeEntries     TimeEntry[]
  comments        Comment[]
  resetTokens     PasswordResetToken[]
  managedClients  Client[]               @relation("clientAccountManager")
  collaborations  RequestCollaborator[]
  commentReads    CommentRead[]
  nudgesShown     NudgeShown[]
  aiMemoryNotes   AiMemoryNote[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Request {
  id             String    @id @default(cuid())
  key            String    @unique
  title          String
  type           String    @default("Solicitud")
  description    String    @default("")
  status         String    @default("POR_HACER")
  priority       String    @default("MEDIA")
  clientPriority Int?
  dueDate        DateTime?
  requesterEmail String    @default("")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  finalizedAt    DateTime?
  // Archivar (Rec. #32) es soft delete: desaparece de tablero/solicitudes/
  // mi-espacio pero sigue contando en reportes e historial de bolsa.
  archivedAt     DateTime?

  clientId String
  client   Client @relation(fields: [clientId], references: [id])

  // Proyecto opcional (fusión con Codia Task) — null = mantención
  // general, como hoy. Nunca lo setean el formulario público ni el
  // portal; es una acción del equipo interno.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  // Subtareas: una subtarea es un Request con padre, hereda
  // clientId/projectId del padre al crearse.
  parentId String?
  parent   Request?  @relation("subtasks", fields: [parentId], references: [id])
  subtasks Request[] @relation("subtasks")

  assigneeId String?
  assignee   User?   @relation("assignee", fields: [assigneeId], references: [id])

  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  attachments       Attachment[]
  comments          Comment[]
  timeEntries       TimeEntry[]
  activities        Activity[]
  collaborators     RequestCollaborator[]
  customFieldValues CustomFieldValue[]
  commentReads      CommentRead[]

  @@index([clientId])
  @@index([assigneeId])
  @@index([status])
  @@index([projectId])
  @@index([parentId])
}

// Gente adicional que puede actuar sobre la tarea, además del
// responsable principal (assigneeId, sin cambios). Aditivo a propósito
// — ver ADR de la fusión con Codia Task, 2026-09-01.
model RequestCollaborator {
  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  addedAt DateTime @default(now())

  @@id([requestId, userId])
}

// Campos personalizados — globales, no por proyecto (decisión
// 2026-09-01: mantener estados/campos compartidos entre todos los
// proyectos para no repetir la complejidad de JIRA).
model CustomFieldDefinition {
  id         String    @id @default(cuid())
  label      String
  type       String // text | textarea | number | date | select | checkbox
  options    String[] @default([])
  sortOrder  Int       @default(0)
  archivedAt DateTime?

  values CustomFieldValue[]
}

model CustomFieldValue {
  id    String @id @default(cuid())
  value String

  fieldId String
  field   CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([fieldId, requestId])
}

// Marca hasta cuándo vio cada usuario los comentarios de una
// solicitud — para el indicador de "el cliente respondió y nadie lo ha
// visto".
model CommentRead {
  userId    String
  requestId String
  readAt    DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id])
  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@id([userId, requestId])
}

model Attachment {
  id        String   @id @default(cuid())
  kind      String   @default("url")
  name      String
  url       String
  createdAt DateTime @default(now())

  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Comment {
  id         String   @id @default(cuid())
  body       String
  isClient   Boolean  @default(false)
  authorName String?
  createdAt  DateTime @default(now())

  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id])
}

model TimeEntry {
  id        String   @id @default(cuid())
  hours     Float
  note      String?
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([requestId])
  @@index([userId])
}

model Activity {
  id        String   @id @default(cuid())
  type      String
  message   String
  actorName String?
  createdAt DateTime @default(now())

  requestId String
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
}

model Notification {
  id             String   @id @default(cuid())
  recipientEmail String
  requestId      String?
  title          String
  body           String
  channel        String   @default("inapp")
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([recipientEmail])
}

// Estados de tablero editables (Rec. #36 fusión, entrega 2, 2026-09-01).
// Request.status sigue siendo un String libre (el "code" acá) — no se
// convierte a FK a propósito, así ningún dato existente necesita
// migrarse. isFinal reemplaza la comparación hardcodeada contra el
// string literal "FINALIZADA" en el cálculo de SLA y los reportes.
model Status {
  id         String    @id @default(cuid())
  code       String    @unique
  label      String
  color      String
  sortOrder  Int       @default(0)
  isFinal    Boolean   @default(false)
  archivedAt DateTime?
}

// Bitácora de seguridad — login, cambios de contraseña, etc. Separada de
// Activity (que es el feed de negocio visible a usuarios) porque tiene otro
// dueño (seguridad, no el cliente) y otro ciclo de vida.
model AuditLog {
  id         String   @id @default(cuid())
  type       String
  actorId    String?
  actorEmail String?
  ip         String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([type])
  @@index([createdAt])
}

// Folio de Request.key (Rec. #65/#67) — antes se calculaba escaneando
// todas las solicitudes y tomando el máximo en memoria: dos creaciones
// concurrentes (formulario público + portal + equipo interno son
// caminos separados) podían calcular el mismo siguiente número. Una fila
// con UPDATE ... SET value = value + 1 es atómica a nivel de Postgres —
// dos transacciones concurrentes nunca leen el mismo valor.
model Counter {
  id    String @id
  value Int    @default(0)
}

// Throttle de los nudges de comportamiento (port de Codia Task, sin IA —
// son 4 reglas SQL sobre tareas asignadas: sin horas, por vencer, sin
// movimiento, sin comentario propio). Una fila por usuario por día:
// evita mostrar el aviso más de una vez al día. Codia Task usaba SSE +
// hasta 2 avisos programados/día; acá se simplifica a 1 por día,
// calculado al cargar /mi-espacio (sin push en tiempo real ni cron —
// no hay infraestructura para eso en Vercel serverless).
model NudgeShown {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  day    String // "YYYY-MM-DD" en America/Santiago

  @@unique([userId, day])
}

// Memoria liviana del asistente IA (fusión Codia Task, fase A — solo
// lectura, sin mutaciones). El propio modelo decide qué anotar vía la
// herramienta rememberNote cuando el usuario dice algo que vale la pena
// recordar entre sesiones (ej. "muéstrame primero las urgentes"); se
// inyectan las últimas notas en el system prompt de cada conversación
// nueva. Reemplaza las tablas ai_user_profiles/ai_interactions de Codia
// Task — mismo propósito, mucho más simple para el alcance de fase A.
model AiMemoryNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
